# Database connection string
# Port 5433 is used to avoid conflicts with existing PostgreSQL on 5432
# To customize credentials, create docker-compose.override.yml (see SETUP.md)
DATABASE_URL=postgresql://user:password@localhost:5433/media_nav_db

# JWT secret for token signing
# IMPORTANT: Change this to a secure random string (min 32 chars)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secret-key-here-min-32-chars

# Directory where plugin wasm modules are located
PLUGINS_DIR=./plugins

# Server host
HOST=127.0.0.1

# Server port
PORT=8080

# Max PostgreSQL connections in the pool
DB_MAX_CONNECTIONS=20
